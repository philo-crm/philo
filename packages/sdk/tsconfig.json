{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM for fetch, Request and crypto.subtle: the SDK runs in browsers and in
    // Node 24, and touches nothing either lacks.
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "types": [],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
