{
  "name": "philo",
  "version": "0.1.0",
  "description": "Self-hosted, single-tenant, agent-usable CRM",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspace apps/web && npm run build --workspace packages/server",
    "db:generate": "npm run db:generate --workspace packages/server --",
    "dev": "npm run dev --workspace packages/server",
    "lint": "oxlint --deny-warnings",
    "start": "node packages/server/dist/index.js",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "oxlint": "1.76.0"
  }
}
